
import 'package:flutter/material.dart';

void main() {
  runApp(const LegalMateApp());
}

class LegalMateApp extends StatelessWidget {
  const LegalMateApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'NAHSRAE Legal AI',
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF173B68),
        ),
        scaffoldBackgroundColor: const Color(0xFFF4F6FA),
      ),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  final TextEditingController controller = TextEditingController();

  final List<Map<String, String>> messages = [];

  bool isTamil = false;

  void sendMessage([String? question]) {
    String text = question ?? controller.text.trim();

    if (text.isEmpty) return;

    setState(() {
      messages.add({
        'message': text,
        'type': 'user',
      });

      messages.add({
        'message':
            'Thank you for your question. Our Legal AI system can help identify the relevant legal domain, retrieve related Indian legal information and guide you through the next steps.\n\nPlease note that this is informational assistance, not professional legal advice.',
        'type': 'bot',
      });
    });

    controller.clear();
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        backgroundColor: const Color(0xFF173B68),
        foregroundColor: Colors.white,
        title: const Row(
          children: [
            Icon(Icons.balance, size: 28),
            SizedBox(width: 10),
            Text(
              'NAHSRAE Legal AI',
              style: TextStyle(fontWeight: FontWeight.bold),
            ),
          ],
        ),
        actions: [
          PopupMenuButton<bool>(
            icon: const Icon(Icons.language),
            onSelected: (value) {
              setState(() => isTamil = value);
            },
            itemBuilder: (context) => const [
              PopupMenuItem(
                value: false,
                child: Text('English'),
              ),
              PopupMenuItem(
                value: true,
                child: Text('Tamil'),
              ),
            ],
          ),
        ],
      ),

      body: Column(
        children: [
          Expanded(
            child: messages.isEmpty
                ? welcomeScreen()
                : ListView.builder(
                    padding: const EdgeInsets.all(16),
                    itemCount: messages.length,
                    itemBuilder: (context, index) {
                      final message = messages[index];
                      bool user = message['type'] == 'user';

                      return Align(
                        alignment: user
                            ? Alignment.centerRight
                            : Alignment.centerLeft,
                        child: Container(
                          constraints: const BoxConstraints(
                            maxWidth: 310,
                          ),
                          margin: const EdgeInsets.symmetric(vertical: 7),
                          padding: const EdgeInsets.all(14),
                          decoration: BoxDecoration(
                            color: user
                                ? const Color(0xFF173B68)
                                : Colors.white,
                            borderRadius: BorderRadius.circular(16),
                          ),
                          child: Text(
                            message['message']!,
                            style: TextStyle(
                              color: user ? Colors.white : Colors.black87,
                              fontSize: 15,
                            ),
                          ),
                        ),
                      );
                    },
                  ),
          ),

          Container(
            padding: const EdgeInsets.all(14),
            color: Colors.white,
            child: Row(
              children: [
                Expanded(
                  child: TextField(
                    controller: controller,
                    decoration: InputDecoration(
                      hintText: isTamil
                          ? 'உங்கள் சட்டக் கேள்வியை உள்ளிடவும்...'
                          : 'Ask your legal question...',
                      border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(25),
                      ),
                      contentPadding: const EdgeInsets.symmetric(
                        horizontal: 18,
                        vertical: 12,
                      ),
                    ),
                    onSubmitted: (_) => sendMessage(),
                  ),
                ),
                const SizedBox(width: 10),
                CircleAvatar(
                  backgroundColor: const Color(0xFF173B68),
                  child: IconButton(
                    onPressed: sendMessage,
                    icon: const Icon(
                      Icons.send,
                      color: Colors.white,
                    ),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget welcomeScreen() {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const SizedBox(height: 25),

          const Center(
            child: CircleAvatar(
              radius: 42,
              backgroundColor: Color(0xFF173B68),
              child: Icon(
                Icons.account_balance,
                color: Colors.white,
                size: 45,
              ),
            ),
          ),

          const SizedBox(height: 20),

          const Center(
            child: Text(
              'Welcome to Legal AI',
              style: TextStyle(
                fontSize: 25,
                fontWeight: FontWeight.bold,
                color: Color(0xFF173B68),
              ),
            ),
          ),

          const SizedBox(height: 10),

          const Center(
            child: Text(
              'AI-powered legal guidance and complaint assistance for India.',
              textAlign: TextAlign.center,
              style: TextStyle(fontSize: 15, color: Colors.black54),
            ),
          ),

          const SizedBox(height: 30),

          const Text(
            'How can we help you?',
            style: TextStyle(
              fontSize: 19,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 15),

          questionCard(
            Icons.shopping_bag_outlined,
            'Consumer Rights',
            'I received a defective product. What can I do?',
          ),

          questionCard(
            Icons.work_outline,
            'Employment Law',
            'My employer has not paid my salary.',
          ),

          questionCard(
            Icons.home_outlined,
            'Property Issues',
            'What should I do about a property dispute?',
          ),

          questionCard(
            Icons.description_outlined,
            'Complaint Assistance',
            'Help me prepare a formal complaint.',
          ),

          const SizedBox(height: 20),

          Container(
            padding: const EdgeInsets.all(15),
            decoration: BoxDecoration(
              color: const Color(0xFFE5EDF8),
              borderRadius: BorderRadius.circular(14),
            ),
            child: const Row(
              children: [
                Icon(Icons.info_outline, color: Color(0xFF173B68)),
                SizedBox(width: 10),
                Expanded(
                  child: Text(
                    'Legal AI provides informational guidance and does not replace a qualified lawyer.',
                    style: TextStyle(fontSize: 12),
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget questionCard(
    IconData icon,
    String title,
    String question,
  ) {
    return Card(
      color: Colors.white,
      elevation: 1,
      margin: const EdgeInsets.only(bottom: 12),
      child: ListTile(
        leading: Icon(
          icon,
          color: const Color(0xFF173B68),
          size: 28,
        ),
        title: Text(
          title,
          style: const TextStyle(fontWeight: FontWeight.bold),
        ),
        subtitle: Text(question),
        trailing: const Icon(Icons.arrow_forward_ios, size: 15),
        onTap: () => sendMessage(question),
      ),
    );
  }
}
